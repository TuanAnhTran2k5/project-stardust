# Hướng dẫn cấu hình Biến Môi Trường (Environment Variables)
# Bạn có thể copy file này thành .env và chỉnh sửa giá trị theo ý muốn:

# 1. Tên hiển thị của cặp đôi (xuất hiện ở màn hình Login & HUD Gallery)
VITE_COUPLE_NAME="Anh & Em"

# 2. Lời nhắn chào mừng lãng mạn ở màn hình đầu tiên
VITE_WELCOME_MESSAGE="Chào mừng em đến với dải ngân hà của chúng mình ✨"

# 3. Mã mở khoá bí mật (Ví dụ: ngày tỏ tình '2010', 'love', 'forever',...)
VITE_PASSCODE="love"

# 4. Ngày bắt đầu yêu (Định dạng YYYY-MM-DD để hiển thị số ngày bên nhau)
VITE_LOVE_DATE="2024-05-20"
